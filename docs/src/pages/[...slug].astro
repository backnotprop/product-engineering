---
import type { GetStaticPaths } from "astro";
import DocsLayout from "../layouts/DocsLayout.astro";
import {
  getDocsStaticPaths,
  getDocsPageProps,
  getRouteFlags,
  getSidebar,
  getPrevNext,
  getBreadcrumbs,
  getEditUrl,
  getLastUpdated,
  getTOC,
} from "@cloudflare/nimbus-docs";
import { PageActions } from "../components/ui/page-actions";
import { components } from "../components";
import skills from "@/data/skills.json";

export const prerender = true;
// The `index` entry is the home page, rendered by pages/index.astro at `/`.
export const getStaticPaths: GetStaticPaths = async (ctx) =>
  (await getDocsStaticPaths(ctx)).filter((p) => p.params?.slug !== "index");

const { entry, Content, headings } = await getDocsPageProps(Astro);

const currentSlug = Astro.url.pathname.replace(/\/$/, "") || "/";

const { sidebar: sidebarOn, tableOfContents: tocOn } = await getRouteFlags(entry);

const sidebar = sidebarOn
  ? await getSidebar(currentSlug, { collection: entry.collection })
  : false;
const prevNext = await getPrevNext(currentSlug, {
  sidebarTree: sidebar === false ? [] : sidebar,
  overrides: { prev: entry.data.prev, next: entry.data.next },
});
const breadcrumbs = await getBreadcrumbs(currentSlug, { collection: entry.collection });
const editUrl = await getEditUrl(entry);
const lastUpdated = entry.data.lastUpdated ?? await getLastUpdated(entry);
const tocConfig = entry.data.tableOfContents;
const toc = tocOn && tocConfig !== false ? getTOC(headings, tocConfig) : false;
const markdownPath = `/${entry.id}/index.md`;
const markdownUrl = Astro.site ? new URL(markdownPath, Astro.site).href : markdownPath;
const socialImage = entry.data.socialImage ?? `/og/${entry.id}.png`;

// The card as the page header: a skill page shows its mono name above the verb
// headline and its mode line below the sentence; a People page shows the
// upstream and license above the author's name. Both come from the `eyebrow`
// frontmatter field, which sync-data.py writes.
const skillKey = entry.id.startsWith("skills/") ? entry.id.slice("skills/".length) : null;
const skill = skillKey && skillKey in skills ? skills[skillKey as keyof typeof skills] : null;
const eyebrow = entry.data.eyebrow ?? skill?.name;
const cardHeader = Boolean(eyebrow);
// A conditional <Fragment slot> still registers as a provided slot, which would
// suppress the layout's default header; branch on the whole layout instead.
const layoutProps = {
  title: entry.data.title, description: entry.data.description,
  sidebar: sidebar === false ? (false as const) : sidebar,
  headings: toc === false ? (false as const) : toc,
  breadcrumbs, prevNext,
  mode: entry.data.mode, banner: entry.data.banner, head: entry.data.head, searchable: entry.data.searchable,
  noindex: entry.data.noindex, markdownUrl, socialImage, lastUpdated, editUrl, draft: entry.data.draft,
  audience: entry.data.audience, collection: entry.collection, entryId: entry.id,
};
---

{cardHeader ? (
  <DocsLayout {...layoutProps}>
    <Fragment slot="page-title">
      <p class="font-mono text-[0.8125rem] text-faint mt-6 mb-2">{eyebrow}</p>
      <h1 class="text-foreground mb-0 leading-tight [text-wrap:balance]" style="font-size:var(--nb-h1-size);font-weight:var(--nb-h1-weight);letter-spacing:var(--nb-h1-tracking)">{entry.data.title}</h1>
      {entry.data.description && (
        <p class="text-[0.9375rem] sm:text-[1.0625rem] text-muted-foreground leading-relaxed mt-2 mb-2 [text-wrap:pretty]">{entry.data.description}</p>
      )}
      {skill?.modeline && <p class="font-mono text-[0.75rem] text-faint mt-1 mb-0">{skill.modeline}</p>}
      <PageActions markdownUrl={markdownUrl} lastUpdated={lastUpdated} class="mt-3" />
      <div class="mt-3 mb-6 h-px w-full bg-border" role="none" />
    </Fragment>
    <Content components={components} />
  </DocsLayout>
) : (
  <DocsLayout {...layoutProps}>
    <Content components={components} />
  </DocsLayout>
)}
